<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>DspGuideCheck</AssemblyName>
    <RootNamespace>DspProgressionStatusExporter</RootNamespace>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Product>DSP Guide Check</Product>
    <Description>An on-demand progression companion for Dyson Sphere Program.</Description>
    <GameRoot Condition="'$(GameRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Dyson Sphere Program</GameRoot>
    <UseCiReferences Condition="'$(UseCiReferences)' == ''">false</UseCiReferences>
    <IncludeSnapshotControl Condition="'$(IncludeSnapshotControl)' == ''">true</IncludeSnapshotControl>
    <DefineConstants Condition="'$(IncludeSnapshotControl)' == 'true'">$(DefineConstants);DSP_GUIDE_SNAPSHOT_CONTROL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Fonts\Basic-Regular.ttf"
                      LogicalName="DspGuideCheck.Fonts.Basic-Regular.ttf" />
    <EmbeddedResource Include="Assets\Fonts\Basic-OFL.txt"
                      LogicalName="DspGuideCheck.Fonts.Basic-OFL.txt" />
    <EmbeddedResource Include="..\..\assets\DSP_exported assets\Texture2D\Recipes (items)\t-matrix.png"
                      LogicalName="DspGuideCheck.MatrixIcons.t-matrix.png" />
    <EmbeddedResource Include="..\..\assets\DSP_exported assets\Texture2D\Recipes (items)\e-matrix.png"
                      LogicalName="DspGuideCheck.MatrixIcons.e-matrix.png" />
    <EmbeddedResource Include="..\..\assets\DSP_exported assets\Texture2D\Recipes (items)\c-matrix.png"
                      LogicalName="DspGuideCheck.MatrixIcons.c-matrix.png" />
    <EmbeddedResource Include="..\..\assets\DSP_exported assets\Texture2D\Recipes (items)\i-matrix.png"
                      LogicalName="DspGuideCheck.MatrixIcons.i-matrix.png" />
    <EmbeddedResource Include="..\..\assets\DSP_exported assets\Texture2D\Recipes (items)\g-matrix.png"
                      LogicalName="DspGuideCheck.MatrixIcons.g-matrix.png" />
    <EmbeddedResource Include="..\..\assets\DSP_exported assets\Texture2D\Recipes (items)\u-matrix.png"
                      LogicalName="DspGuideCheck.MatrixIcons.u-matrix.png" />
    <EmbeddedResource Include="..\..\assets\DSP_exported assets\Texture2D\Tech\1605.png"
                      LogicalName="DspGuideCheck.MatrixIcons.1605.png" />
    <EmbeddedResource Include="..\..\assets\DSP_exported assets\Texture2D\Recipes (items)\solar-collector.png"
                      LogicalName="DspGuideCheck.MatrixIcons.solar-collector.png" />
    <EmbeddedResource Include="..\..\assets\DSP_exported assets\Texture2D\Recipes (items)\photon-capacitor-full.png"
                      LogicalName="DspGuideCheck.MatrixIcons.photon-capacitor-full.png" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseCiReferences)' != 'true'">
    <Reference Include="BepInEx">
      <HintPath>$(GameRoot)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameRoot)\DSPGAME_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameRoot)\DSPGAME_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameRoot)\DSPGAME_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameRoot)\DSPGAME_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameRoot)\DSPGAME_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameRoot)\DSPGAME_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameRoot)\DSPGAME_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseCiReferences)' == 'true'">
    <Reference Include="BepInEx">
      <HintPath>$(CiBepInExPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference
      Include="Microsoft.NETFramework.ReferenceAssemblies.net472"
      Version="1.0.3"
      PrivateAssets="all" />
    <PackageReference
      Include="UnityEngine.Modules"
      Version="2021.3.33"
      PrivateAssets="all"
      ExcludeAssets="runtime" />
    <PackageReference
      Include="Unity3D.UnityEngine.UI"
      Version="2018.3.5.1"
      PrivateAssets="all"
      ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
